# Virtual environments
.venv/
venv/

# Environment variables
.env

# Streamlit secrets (never commit real keys)
.streamlit/secrets.toml

# Python cache
__pycache__/
*.pyc

# Python build / packaging artifacts
*.egg-info/
build/
dist/

# HuggingFace cache
.cache/

# Editor / OS files
.vscode/
.DS_Store

# Claude Code tooling (specs & local settings — not part of the project)
.claude/

# Logs & temp
*.log
tmp/

# Generated / local artifacts
mlruns/
mlflow.db

# Legacy Chroma vector store — removed in the TMDB migration. This guard only
# prevents re-committing a stale local copy that may still linger on disk.
cinellex_rag/retrieval/chroma_store/

# TMDB response cache (regenerated on demand from the TMDB API)
data/tmdb_cache.json

# Generated evaluation output (regenerate via evaluation/run_ragas.py)
evaluation/results/

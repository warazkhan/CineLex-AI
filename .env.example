# Copy this file to .env and fill in your own keys.
# Both services here run on free tiers — no paid API required.

# TMDB (The Movie Database) — the app's live movie data source. Every route
# (analytics / RAG / recommendations) queries TMDB at request time. Get a free
# key at https://www.themoviedb.org/settings/api — a v3 API key OR a v4 Read
# Access Token both work. Without it the app runs but returns a friendly
# "TMDB not configured" message instead of data.
TMDB_API_KEY=your_tmdb_key_here
# Optional: set to false to disable TMDB calls without removing the key above.
TMDB_ENABLED=true
# Optional: poster size — w185, w342, w500, w780 or original.
TMDB_POSTER_SIZE=w500
# Optional: language/region for titles, overviews and certifications.
TMDB_LANG=en-US
# Optional: minimum vote count for ranking queries (mirrors TMDB's "top rated" rule).
TMDB_VOTE_COUNT_FLOOR=300

# Groq API key — powers the LLM generation and the recommendation crew
# (and the optional RAGAS evaluation judge). Get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# CrewAI telemetry toggles
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_TELEMETRY=true

# Base URL of the FastAPI backend the Streamlit UI talks to. Locally this is
# injected by docker-compose (http://api:8000); set it on the Render UI service
# to point at the deployed API.
API_URL=https://cinellex-api.onrender.com

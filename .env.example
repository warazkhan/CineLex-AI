# Copy this file to .env and fill in your own keys.
# All services here run on free tiers — no paid API required.

# Groq API key — powers the LLM generation, the recommendation crew,
# and the RAGAS evaluation judge. Get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace token — used to download the embedding model
# (sentence-transformers/all-MiniLM-L6-v2). https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# CrewAI telemetry toggles
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_TELEMETRY=true
